{
  "name": "@lumine-code/node-pty",
  "author": "lumine-code",
  "description": "Forks processes with pseudoterminal file descriptors.",
  "version": "2.1.0",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./typings/node-pty.d.ts",
  "repository": "https://github.com/lumine-code/node-pty",
  "bugs": "https://github.com/lumine-code/node-pty/issues",
  "homepage": "https://github.com/lumine-code/node-pty",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "binding.gyp",
    "lib/**/*.js",
    "!lib/**/*.test.js",
    "scripts/post-install.js",
    "scripts/prebuild.js",
    "src/**/*.{cc,h}",
    "prebuilds/",
    "third_party/",
    "typings/"
  ],
  "keywords": [
    "pty",
    "pseudoterminal",
    "conpty",
    "forkpty",
    "terminal",
    "tty",
    "native",
    "lumine"
  ],
  "scripts": {
    "build": "tsc -b ./src/tsconfig.json",
    "watch": "tsc -b -w ./src/tsconfig.json",
    "lint": "eslint src/",
    "install": "node scripts/prebuild.js || node-gyp rebuild",
    "postinstall": "node scripts/post-install.js",
    "compileCommands": "node scripts/gen-compile-commands.js",
    "test": "cross-env NODE_ENV=test jasmine",
    "posttest": "npm run lint",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "node-addon-api": "^8.9.0"
  },
  "lem": {
    "hold": {
      "typescript": "7.0 removed target ES5 and no longer finds @types from src/tsconfig.json, so it changes the shipped emit and the tsconfig; not worth diverging from an upstream this fork is level with",
      "@types/node": "tracks the Node major engines targets, not the newest published",
      "ps-list": "ESM-only from v7, so the bump edits an upstream-owned test file for a dev dependency"
    }
  },
  "devDependencies": {
    "@types/jasmine": "^6.0.0",
    "jasmine": "^6.3.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "node-gyp": "^13.0.1",
    "ps-list": "^6.0.0",
    "typescript": "^5.9.3"
  }
}
