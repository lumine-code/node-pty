{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "bundler",
    "target": "es2015",
    "rootDir": ".",
    "outDir": "../lib",
    "sourceMap": true,
    "lib": [
      "es2015"
    ],
    "strict": true,
    "types": [
      "node",
      "jasmine"
    ]
  },
  "exclude": [
    "node_modules",
    "scripts",
    "index.js",
    "demo.js",
    "lib",
    "test",
    "examples"
  ]
}
